{
  "name": "emerald-desktop",
  "version": "1.0.0",
  "description": "Emerald — віртуальний помічник (Windows Desktop)",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "node server.js",
    "electron-start": "electron .",
    "pack": "electron-builder --win portable",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.emerald.assistant",
    "productName": "Emerald",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.cjs",
      "botController.cjs",
      "package.json",
      "public/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "public/favicon.ico",
      "sign": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "expr-eval": "^2.0.2",
    "express": "^4.18.4",
    "helmet": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
